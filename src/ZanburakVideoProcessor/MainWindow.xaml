<Window x:Class="ZanburakVideoProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پردازشگر ویدیو زنبورک"
        Height="560" Width="560"
        MinHeight="500" MinWidth="480"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI, Tahoma">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#B45309"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#111827" CornerRadius="16" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="پردازشگر محلی زنبورک" FontSize="12" Foreground="#FCD34D" FontWeight="SemiBold"/>
                <TextBlock x:Name="TitleText" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Text="در حال آماده‌سازی"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="13" Foreground="#D1D5DB" TextWrapping="Wrap" Text="آماده‌سازی"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="ویدیوی آپلودشده"/>
                        <TextBlock x:Name="SourceText" Margin="0,6,0,0" FontSize="13" Foreground="#111827" TextWrapping="Wrap" Text="در انتظار اطلاعات عملیات"/>
                        <TextBlock x:Name="MetaText" Margin="0,8,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Text=""/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="پیشرفت کلی"/>
                            <TextBlock Grid.Column="1" x:Name="OverallPercent" Style="{StaticResource Pct}" Text="۰٪"/>
                        </Grid>
                        <ProgressBar x:Name="OverallBar" Style="{StaticResource Bar}" Value="0"/>

                        <Grid Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="دانلود از سرور"/>
                            <TextBlock Grid.Column="1" x:Name="DownloadPercent" Style="{StaticResource Pct}" Text="۰٪"/>
                        </Grid>
                        <ProgressBar x:Name="DownloadBar" Style="{StaticResource Bar}" Value="0"/>

                        <Grid Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="پردازش ویدیو"/>
                            <TextBlock Grid.Column="1" x:Name="EncodePercent" Style="{StaticResource Pct}" Text="۰٪"/>
                        </Grid>
                        <ProgressBar x:Name="EncodeBar" Style="{StaticResource Bar}" Value="0"/>

                        <Grid Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="آپلود خروجی"/>
                            <TextBlock Grid.Column="1" x:Name="UploadPercent" Style="{StaticResource Pct}" Text="۰٪"/>
                        </Grid>
                        <ProgressBar x:Name="UploadBar" Style="{StaticResource Bar}" Value="0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FinishedCard" Style="{StaticResource Card}"
                        Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FinishedText" FontSize="14" FontWeight="Bold" Foreground="#065F46"
                                   TextWrapping="Wrap" Text="✅ پردازش با موفقیت به پایان رسید."/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#047857" TextWrapping="Wrap"
                                   Text="هر دو مرحله (پردازش و آپلود) کامل شد و خروجی‌ها در سایت ثبت شدند. ادامه کار را از صفحه جلسه در سایت انجام دهید."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14">
                    <TextBlock x:Name="MessageText" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap"
                               Text="اپ از سایت باز می‌شود و همان ویدیوی آپلودشده را پردازش می‌کند."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="RetryButton" Content="تلاش مجدد" Click="OnRetry"
                Background="#F59E0B" Foreground="#111827" FontWeight="Bold"
                HorizontalAlignment="Stretch" Padding="16,10" Visibility="Collapsed"/>
    </Grid>
</Window>
